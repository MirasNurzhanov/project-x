# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
#
#   cp .env.example .env
#
# On Railway these same names go in the project's Variables tab instead.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me
DEBUG=False
DATABASE_URL=postgres://user:pass@host:5432/dbname
REDIS_URL=redis://localhost:6379

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Media for stories, chat photos and Swift video. Swift uploads are *signed*
# with these (see swifts/media.py), so the secret has to be set for video to
# work at all.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Epidemic Sound ────────────────────────────────────────────────────────────
# ►► THE MUSIC API KEY GOES HERE ◄◄
#
# Issued under Epidemic Sound's PARTNER / API agreement — not with an ordinary
# subscription. A subscription licenses you to use their music in your own
# content; Aura redistributes music inside videos its users publish, which is a
# different licence and is not self-serve.
#
# Leave blank and everything still works: the Swift track picker reads Aura's
# own catalogue, which you can fill by hand in the admin. These only enable the
# importer.
#
# Check with:  python manage.py sync_music --status
# Import with: python manage.py sync_music epidemic --term "lo-fi" --limit 50
EPIDEMIC_SOUND_CLIENT_ID=
EPIDEMIC_SOUND_CLIENT_SECRET=

# The licence text stored against every imported track. Shown in the admin,
# never sent to creators. Set it to whatever your agreement is actually called.
EPIDEMIC_SOUND_LICENCE=Epidemic Sound partner agreement
# Only if your agreement requires a per-track credit line.
EPIDEMIC_SOUND_ATTRIBUTION=

# Endpoints. Defaults are in core/settings.py; override only if the partner
# documentation issued with your agreement gives different ones.
# EPIDEMIC_SOUND_BASE_URL=
# EPIDEMIC_SOUND_TOKEN_URL=
# EPIDEMIC_SOUND_SEARCH_PATH=
# EPIDEMIC_SOUND_TRACK_PATH=

# ── Apple Music (music zone only — unrelated to Swift music) ──────────────────
# These power the zone's track picker, not the Swift composer's. Swifts
# deliberately do not use them: a zone streams Apple's own 30-second preview to
# a listener, where a Swift bakes audio into a file Aura redistributes. Same
# audio, different act, and Apple's terms cover only the first.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

# ── Sign in with Google / Apple ───────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_SIGN_IN_CLIENT_IDS=

# ── Swift throttles (optional; defaults live in core/settings.py) ─────────────
# THROTTLE_SWIFT_REVEAL=60/hour
# THROTTLE_SWIFT_CREATE=30/hour
# THROTTLE_SWIFT_REPORT=20/hour
