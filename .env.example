# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
#
#   cp .env.example .env
#
# On Railway these same names go in the project's Variables tab instead.

# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me
# False on Railway. Set True for local development, or HTTPS redirects and
# secure-only cookies apply to runserver too.
DEBUG=False
DATABASE_URL=postgres://user:pass@host:5432/dbname
REDIS_URL=redis://localhost:6379

# ── Hosts, origins and proxy trust ────────────────────────────────────────────
# Exact hostnames, comma-separated, no '*'. Required when DEBUG=False: Django
# refuses to start without it. Add the Railway private hostname too if the Go
# moderation worker calls Django over the private network.
ALLOWED_HOSTS=project-x-production-3261.up.railway.app
# Exact browser origins allowed to call /api/ (e.g. the web frontend). Blank = none.
CORS_ALLOWED_ORIGINS=
# Exact origins trusted for cross-site form POSTs. Wildcards are refused at
# startup. The admin is same-origin and needs none.
CSRF_TRUSTED_ORIGINS=
# Read by uvicorn (Procfile `web`), not Django: the only peers whose
# X-Forwarded-Proto / X-Forwarded-For are applied. Django takes the request
# scheme from uvicorn, so this must be the address range Railway's edge proxy
# connects from, verified with Railway. Comma-separated IPs or CIDRs; never '*',
# 0.0.0.0/0 or ::/0. Required when DEBUG=False: the web process refuses to start
# without a valid value. Not needed for local development (DEBUG=True).
FORWARDED_ALLOW_IPS=<verified Railway trusted proxy CIDR>
# HSTS rollout: one hour by default. Raise (86400, then 604800, then 31536000)
# only once every hostname above is confirmed HTTPS-only; browsers cache it.
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# Emergency switch only; leave on in production.
# SECURE_SSL_REDIRECT=True

# ── Cloudflare R2 storage — all six names are required for production ─────────
# S3 API credentials scoped to the two buckets below. Never use real values here.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket: avatars, stories, and legacy media. Existing objects are not
# moved automatically by the private-media rollout.
R2_BUCKET_NAME=
# Separate private bucket for NEW DM/club photos and Swift video/thumbnails.
# Disable public r2.dev and custom-domain access on this bucket. Signed URLs
# expire after 300 seconds. See docs/codebase-review-fixes/M3.md before rollout.
R2_PRIVATE_BUCKET_NAME=
# S3 API endpoint, not the public CDN URL:
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Absolute HTTPS custom-domain origin for the public bucket:
R2_PUBLIC_URL=https://media.example.test

# ── Epidemic Sound ────────────────────────────────────────────────────────────
# ►► THE MUSIC API KEY GOES HERE ◄◄
#
# Issued under Epidemic Sound's PARTNER / API agreement — not with an ordinary
# subscription. A subscription licenses you to use their music in your own
# content; Approx redistributes music inside videos its users publish, which is a
# different licence and is not self-serve.
#
# Leave blank and everything still works: the Swift track picker reads Approx's
# own catalogue, which you can fill by hand in the admin. These only enable the
# importer.
#
# Check with:  python manage.py sync_music --status
# Import with: python manage.py sync_music epidemic --term "lo-fi" --limit 50
EPIDEMIC_SOUND_CLIENT_ID=
EPIDEMIC_SOUND_CLIENT_SECRET=

# The licence text stored against every imported track. Shown in the admin,
# never sent to creators. Set it to whatever your agreement is actually called.
EPIDEMIC_SOUND_LICENCE=Epidemic Sound partner agreement
# Only if your agreement requires a per-track credit line.
EPIDEMIC_SOUND_ATTRIBUTION=

# Endpoints. Defaults are in core/settings.py; override only if the partner
# documentation issued with your agreement gives different ones.
# EPIDEMIC_SOUND_BASE_URL=
# EPIDEMIC_SOUND_TOKEN_URL=
# EPIDEMIC_SOUND_SEARCH_PATH=
# EPIDEMIC_SOUND_TRACK_PATH=

# ── Apple Music (music zone only — unrelated to Swift music) ──────────────────
# These power the zone's track picker, not the Swift composer's. Swifts
# deliberately do not use them: a zone streams Apple's own 30-second preview to
# a listener, where a Swift bakes audio into a file Approx redistributes. Same
# audio, different act, and Apple's terms cover only the first.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

# ── Sign in with Google / Apple ───────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_SIGN_IN_CLIENT_IDS=

# ── Cloudflare AI moderation for Swift video ──────────────────────────────────
# ►► THE CLOUDFLARE API TOKEN GOES HERE — AND NOWHERE ELSE ◄◄
#
# These two are the only secrets this feature has, they are read in exactly one
# place (`moderation.cloudflare_ai.credentials`), and they never leave the
# server: not to the app, not into a response body, not into the database, not
# into a log line. `moderation/test_cloudflare_ai.py::TokenSecrecyTests` and
# `swifts/test_ai_moderation.py::NoLeakTests` are what hold that.
#
# The token needs the **Workers AI** permission on this account. Nothing else.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# The master switch, and it defaults to off. With it off a Swift publishes
# exactly the way it did before this feature existed, so this can ship ahead of
# the Cloudflare dashboard work and be turned on with a variable change.
#
# Turn it on only once Media Transformations are enabled on the zone that
# serves R2_PUBLIC_URL — otherwise every new Swift is held at PENDING and stays
# invisible until the sweeper gives up and quarantines it for a human.
SWIFT_AI_MODERATION_ENABLED=False
# Required when enabled: a supervised `python manage.py moderate_swifts --loop`
# service (or the Go moderation worker). Web uploads now only enqueue DB jobs.
# Keep synchronous inference OFF in web processes; test settings enable it only
# to make assertions deterministic.
SWIFT_AI_MODERATION_SYNC=False
# Required if using services/go-moderation. The SAME high-entropy shared secret
# goes on Django and that worker. Blank disables internal lease/settle endpoints.
MODERATION_WORKER_TOKEN=

# Where /cdn-cgi/media/ is served. Blank means "use R2_PUBLIC_URL", which is
# right when the bucket is published on a custom domain in the same Cloudflare
# account. If R2_PUBLIC_URL is an `*.r2.dev` address this MUST be set to a
# custom domain instead: transformations are enabled per zone, and r2.dev is
# Cloudflare's hostname rather than one of yours.
# CLOUDFLARE_MEDIA_TRANSFORM_BASE=
# Verify that this zone can fetch short-lived signed private R2 sources; do not
# make the private bucket public to make transformations work.

# Model choice, both configurable because the Workers AI catalogue moves faster
# than this codebase does. Defaults are in core/settings.py.
# CLOUDFLARE_AI_VISION_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# CLOUDFLARE_AI_TRANSCRIBE_MODEL=@cf/openai/whisper

# Cost and latency controls. FRAME_COUNT=0 lets the video's duration decide
# (5 frames for a short clip, 10 for a long one); FRAME_MAX is the ceiling that
# actually bounds the bill.
# SWIFT_AI_FRAME_COUNT=0
# SWIFT_AI_FRAME_MAX=12
# SWIFT_AI_FRAME_WIDTH=640
# SWIFT_AI_UNSAFE_CONFIDENCE=0.75
# CLOUDFLARE_AI_TIMEOUT_S=30
# SWIFT_AI_MAX_ATTEMPTS=3
# SWIFT_AI_STALE_AFTER_S=900

# Phase 2: transcribe the audio track and run the transcript through the same
# text filter the caption goes through. Off until the transformation origin
# above is confirmed working — see the note in core/settings.py.
# SWIFT_AI_AUDIO_MODERATION_ENABLED=False

# ── Swift throttles (optional; defaults live in core/settings.py) ─────────────
# THROTTLE_SWIFT_REVEAL=60/hour
# THROTTLE_SWIFT_CREATE=30/hour
# THROTTLE_SWIFT_REPORT=20/hour
# Authentication and abuse budgets (DRF ScopedRateThrottle; shared Redis in production).
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_REFRESH=120/hour
THROTTLE_SOCIAL_LOGIN=30/min
THROTTLE_MAP_QUERY=1200/hour
THROTTLE_SOCIAL_REQUEST=30/hour

# ── Optional Go push dispatcher ──────────────────────────────────────────────
# Blank URL uses Django's bounded in-process sender (2 workers, 32 queued/running
# tasks). Overflow/failure is logged and never rolls back a saved message.
PUSH_DISPATCHER_URL=
PUSH_DISPATCHER_TOKEN=
# On the GO service, configure PUSH_AUTH_TOKEN to the same shared secret and:
# PUSH_DEAD_TOKEN_URL=https://api.example.test/api/internal/push/dead-tokens/
# Required for dead-token cleanup through Go. No redirects are followed. Do not
# expose an unauthenticated dispatcher to the public internet.

# DATABASE_URL above is the recommended database configuration. If omitted,
# settings require ALL five legacy values with no defaults instead:
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# Production also requires exact ALLOWED_HOSTS, verified FORWARDED_ALLOW_IPS,
# and shared REDIS_URL (socket-ticket single use and rate limits).
# No other unconditional config() calls without defaults exist in core/settings.py.
